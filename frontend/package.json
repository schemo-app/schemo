{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "translations:check": "node scripts/check-translations.mjs",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite",
    "build": "npm run translations:check && vue-tsc -b && vite build --mode production",
    "build:dev": "vue-tsc -b && vite build --minify false --mode development",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.47.0",
    "@milkdown/kit": "^7.22.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "14.4.0",
    "@wailsio/runtime": "3.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.1.0"
  }
}
