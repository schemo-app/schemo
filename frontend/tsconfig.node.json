{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // The compiled config, its declarations and the build's bookkeeping go where nothing
    // reads them: a referenced project cannot be told not to emit at all, and a
    // `vite.config.js` beside the real one is a config Vite might load instead of it.
    "outDir": "node_modules/.tmp",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ESNext"],
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts"
  ]
}
